{
  "name": "@cinatra-ai/blog-linkedin-publish-agent",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "description": "Publishes the LinkedIn post ARTIFACT revision a person continued with to a connected LinkedIn destination and writes the address back onto that artifact. Takes an artifact reference (linkedinArtifactId + linkedinRepresentationRevisionId), confirms with the person before anything goes out, posts through the LinkedIn connector, and merges the address onto the artifact's data. Returns a receipt, never a new artifact — the LinkedIn writer authors the post, this agent does not.",
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "files": [
    "cinatra",
    "src"
  ],
  "peerDependencies": {
    "@cinatra-ai/sdk-extensions": "*",
    "@cinatra-ai/sdk-ui": "*",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@cinatra-ai/sdk-extensions": {
      "optional": true
    },
    "@cinatra-ai/sdk-ui": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.0.0",
    "vitest": "^4.0.0"
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "agent",
    "displayName": "Blog LinkedIn Publish Agent",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/linkedin-artifacts",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      },
      {
        "packageName": "@cinatra-ai/linkedin-connector",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.2"
        },
        "requirement": "required",
        "kind": "connector"
      }
    ],
    "consumes": [
      {
        "primitive": "artifacts_get",
        "requirement": "required"
      },
      {
        "primitive": "artifact_content_read",
        "requirement": "required"
      },
      {
        "primitive": "objects_update",
        "requirement": "required"
      },
      {
        "primitive": "linkedin_post_publish",
        "requirement": "required"
      }
    ],
    "fieldRenderers": [
      {
        "id": "@cinatra-ai/blog-linkedin-publish-agent:draft-review",
        "kind": "linkedin-draft-review",
        "priority": 90,
        "midRunHitl": true,
        "component": {
          "entry": "./src/renderers/draft-review.tsx",
          "propsApiVersion": 1
        }
      }
    ],
    "packageType": "agent",
    "manifestVersion": 1,
    "sourceTemplateId": "blog-linkedin-publish-agent-flow",
    "sourceVersionId": "1cbf4db1-89ee-403b-977c-a7adb5f97b73",
    "sourceVersionNumber": 1,
    "riskLevel": "low",
    "hasApprovalGates": false,
    "toolAccess": [],
    "ownerOrgId": null,
    "produces": []
  }
}
